# =====================================================================
# Trishul backend environment configuration
# Copy this file to `.env` and override the values for your environment.
# `.env` is gitignored and must NEVER be committed.
# =====================================================================

# --- Core ---
APP_NAME=Trishul
DEMO_MODE=true
ENVIRONMENT=development

# --- Database ---
# SQLite for local dev. Use a postgres:// URL for production / Docker Compose.
DATABASE_URL=sqlite:///./trishul.db

# --- Supabase (optional) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Alert delivery (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL=
ALERT_COOLDOWN_SECONDS=120

# --- Twilio SMS alerting (optional) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+12345678901
ALERT_SMS_NUMBERS=+919876543210,+919123456780

# --- Simulation / live data ---
SIMULATION_INTERVAL_SECONDS=2.0
DATA_MODE=simulation
WEATHER_POLL_INTERVAL_SECONDS=600

# --- Risk model ---
MODEL_VERSION=risk-fusion-v1.0.0-demo
STALE_READING_SECONDS=900

# --- OAuth (Google / Facebook) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173

# --- Sessions & JWT ---
# Optional: if unset, a random per-process secret is generated (sessions/JWT
# will not survive a restart). Generate a strong value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=168
