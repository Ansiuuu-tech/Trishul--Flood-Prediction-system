# =============================================================================
# Trishul — Environment Configuration (Demo Mode)
# =============================================================================
# Copy this file to `.env` and fill in your real credentials for production.
# For local development, the defaults below work as-is (SQLite, no auth needed).
# Nothing needs to be filled in to run the primary demo.
# =============================================================================

# --- Backend ---
# SQLite (zero-config) is the default. Set this to a PostgreSQL URL for
# Docker Compose or Supabase.
DATABASE_URL=sqlite:///./trishul.db

# --- CORS ---
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Environment ---
ENVIRONMENT=development
DEMO_MODE=true

# --- Supabase (optional, for production deployments) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Alerting (optional — falls back to demo-mode delivery) ---
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL=

# Per-zone alert cooldown in seconds (prevents duplicate alerts)
ALERT_COOLDOWN_SECONDS=120

# --- Simulation ---
# Seconds between simulation ticks (lower = faster demo)
SIMULATION_INTERVAL_SECONDS=2.0

# --- Risk model ---
MODEL_VERSION=risk-fusion-v1.0.0-demo
# Readings older than this (in seconds) get a data-quality warning
STALE_READING_SECONDS=900

# --- OAuth (Google / Facebook — optional, Phase 4) ---
# Leave empty for local demo; OAuth endpoints return 503 until configured.
#   Google: console.cloud.google.com -> OAuth consent screen -> Credentials
#   Facebook: developers.facebook.com -> Facebook Login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Frontend URL (for OAuth redirects) ---
FRONTEND_URL=http://localhost:5173

# --- Sessions & JWT ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If left empty, a random per-process secret is generated (sessions reset on restart).
SESSION_SECRET=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=168
